# Copy to .env for local runs. NEVER commit .env.
LINGO_ENV=prod                     # prod | stage
# BASE_URL=https://www.adobe.com   # optional override
# UA_SUFFIX=NALA-Acom              # allow-listed UA suffix (empty = disabled)
SLACK_WEBHOOK_URL=                 # Slack incoming webhook (leave empty to skip Slack locally)
# SLACK_MENTION=<!subteam^S0123456> # optional: tagged only when something fails
